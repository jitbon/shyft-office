{
  "name": "shyft-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "sprites:template": "tsx tools/sprite-template.ts",
    "sprites:check": "tsx tools/sprite-check.ts",
    "bots": "tsx tools/bots.ts",
    "objects:template": "tsx tools/object-template.ts",
    "objects:check": "tsx tools/object-check.ts",
    "items:template": "tsx tools/item-template.ts",
    "items:check": "tsx tools/item-check.ts"
  },
  "dependencies": {
    "tsx": "^4.20.0",
    "ws": "^8.18.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "vitest": "^3.2.0"
  }
}
